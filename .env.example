# Office to run with Docker: the name of a folder in ./offices
OFFICE=

# Run each agent in its own container (see docker-compose.override.example.yml)
SANDBOX=none

# API keys (not needed for local llama.cpp / vLLM models)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Discord bot: chat with the office from your Discord server (see README → Discord)
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# Avatars per sender; "{name}" is replaced, "none" turns them off
# DISCORD_AVATAR_URL=https://api.dicebear.com/9.x/bottts-neutral/png?seed={name}
# Activity category, #status and the bot's status line (set to off to skip)
# DISCORD_ACTIVITY=on
# Biggest file to upload to Discord in MB (10 without server boosts)
# DISCORD_MAX_UPLOAD_MB=10
